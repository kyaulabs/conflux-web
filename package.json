{
  "name": "@kyaulabs/conflux-web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node tests/server.mjs",
    "build": "npm run build:js && npm run build:css",
    "build:js": "uglifyjs signal.js --compress --mangle --output signal.min.js && uglifyjs app.js --compress --mangle --output app.min.js",
    "build:css": "sass --style=compressed --no-source-map --no-error-css styles.scss styles.min.css",
    "lint": "eslint .",
    "test": "npm run build && playwright test",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "sass": "^1.108.2",
    "uglify-js": "^3.19.3"
  }
}
